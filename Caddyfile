# FifthSeason
fifth-season.de {
    handle /api/* {
        reverse_proxy fs-backend:5000
    }

    # Login v2 (Next.js-Container) — muss vor dem allgemeinen Zitadel-Match stehen.
    handle /ui/v2/login* {
        reverse_proxy fs-login:3000
    }

    @zitadel {
        path /oauth/* /oidc/* /.well-known/* /ui/* /management/* /admin/* /v2/* /debug/* /zitadel.* /caos.*
    }
    handle @zitadel {
        reverse_proxy fs-zitadel:8080
    }

    handle {
        reverse_proxy fs-frontend:3000
    }
}

# Tourenplanung — statische Nuxt-App (IndexedDB, kein Backend)
tourenplanung.hdave.net {
    reverse_proxy tp-web:80
}

# Pilzlichtung — Spiel-Server (Updates, Feedback, Wunschtafel) + Admin-Seite unter /admin/
pilzlichtung.hdave.net {
    encode zstd gzip
    # Releases (pck + zip) können groß sein
    request_body {
        max_size 200MB
    }
    reverse_proxy pilzlichtung:8080 {
        transport http {
            read_timeout 10m
            write_timeout 10m
        }
    }
}
